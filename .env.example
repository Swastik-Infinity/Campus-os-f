# ==============================================================================
# CampusOS v1.2 — Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=8080
NODE_ENV=development
API_PREFIX=/api/v1

# Frontend URL (for CORS headers in production)
FRONTEND_URL=http://localhost:8080

# Security Secrets
# Replace with a cryptographically secure random string in production (e.g., openssl rand -base64 32)
JWT_SECRET=campusos-insecure-development-secret-change-in-production-2026
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL / Supabase)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
DATABASE_SSL=false

# Demo & Fallback Configuration
# When ENABLE_LOCAL_FALLBACK=true, if DATABASE_URL is not provided or unreachable,
# CampusOS seamlessly initializes a local SQLite relational store so offline dev & testing work 100%.
ENABLE_LOCAL_FALLBACK=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=30
